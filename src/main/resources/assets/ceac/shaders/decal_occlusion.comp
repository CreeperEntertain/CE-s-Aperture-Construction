#version 430

layout(local_size_x = 64) in;

struct DecalData {
    vec4 origin;
    vec4 normal;
    vec4 volumeAndRotation;
    vec4 textureBounds;
    vec4 textureInfo;
};

layout(std430, binding = 0) readonly buffer DecalBuffer {
    DecalData decals[];
};

layout(std430, binding = 1) writeonly buffer VisibilityBuffer {
    uint visible[];
};

layout(binding = 0) uniform sampler2D DepthPyramid;

uniform mat4 ViewProjection;
uniform int DecalCount;
uniform int PyramidLevels;
uniform vec2 ScreenSize;
uniform vec3 CameraPosition;

const uint VISIBLE = 1u;
const uint OCCLUDED = 0u;

void getDecalBasis(
        vec3 normal,
        float rotation,
        out vec3 tangent,
        out vec3 bitangent
) {
    normal = normalize(normal);

    vec3 reference = abs(normal.y) < 0.999
        ? vec3(0.0, 1.0, 0.0)
        : vec3(1.0, 0.0, 0.0);

    tangent = normalize(cross(reference, normal));
    bitangent = normalize(cross(normal, tangent));

    float angle = radians(22.5) * rotation;

    float c = cos(angle);
    float s = sin(angle);

    vec3 rotatedTangent = tangent * c + bitangent * s;
    vec3 rotatedBitangent = -tangent * s + bitangent * c;

    tangent = rotatedTangent;
    bitangent = rotatedBitangent;
}

float cross2(
        vec2 a,
        vec2 b
) {
    return a.x * b.y - a.y * b.x;
}

bool pointInRect(
        vec2 p,
        vec2 minP,
        vec2 maxP
) {
    return
        p.x >= minP.x &&
        p.x <= maxP.x &&
        p.y >= minP.y &&
        p.y <= maxP.y;
}

bool pointInQuad(
        vec2 p,
        vec2 a,
        vec2 b,
        vec2 c,
        vec2 d
) {
    float c1 = cross2(b - a, p - a);
    float c2 = cross2(c - b, p - b);
    float c3 = cross2(d - c, p - c);
    float c4 = cross2(a - d, p - d);

    return (
        c1 >= 0.0 &&
        c2 >= 0.0 &&
        c3 >= 0.0 &&
        c4 >= 0.0
    ) || (
        c1 <= 0.0 &&
        c2 <= 0.0 &&
        c3 <= 0.0 &&
        c4 <= 0.0
    );
}

bool segmentIntersectsSegment(
        vec2 a1,
        vec2 a2,
        vec2 b1,
        vec2 b2
) {
    float d1 = cross2(a2 - a1, b1 - a1);
    float d2 = cross2(a2 - a1, b2 - a1);
    float d3 = cross2(b2 - b1, a1 - b1);
    float d4 = cross2(b2 - b1, a2 - b1);

    return (d1 * d2 <= 0.0) && (d3 * d4 <= 0.0);
}

bool quadIntersectsRect(
        vec2 a,
        vec2 b,
        vec2 c,
        vec2 d,
        vec2 rectMin,
        vec2 rectMax
) {
    if (pointInRect(a, rectMin, rectMax) ||
        pointInRect(b, rectMin, rectMax) ||
        pointInRect(c, rectMin, rectMax) ||
        pointInRect(d, rectMin, rectMax))
        return true;

    if (pointInQuad(rectMin, a, b, c, d) ||
        pointInQuad(vec2(rectMax.x, rectMin.y), a, b, c, d) ||
        pointInQuad(rectMax, a, b, c, d) ||
        pointInQuad(vec2(rectMin.x, rectMax.y), a, b, c, d))
        return true;

    vec2 rectA = rectMin;
    vec2 rectB = vec2(rectMax.x, rectMin.y);
    vec2 rectC = rectMax;
    vec2 rectD = vec2(rectMin.x, rectMax.y);

    if (segmentIntersectsSegment(a, b, rectA, rectB) ||
        segmentIntersectsSegment(a, b, rectB, rectC) ||
        segmentIntersectsSegment(a, b, rectC, rectD) ||
        segmentIntersectsSegment(a, b, rectD, rectA) ||
        segmentIntersectsSegment(b, c, rectA, rectB) ||
        segmentIntersectsSegment(b, c, rectB, rectC) ||
        segmentIntersectsSegment(b, c, rectC, rectD) ||
        segmentIntersectsSegment(b, c, rectD, rectA) ||
        segmentIntersectsSegment(c, d, rectA, rectB) ||
        segmentIntersectsSegment(c, d, rectB, rectC) ||
        segmentIntersectsSegment(c, d, rectC, rectD) ||
        segmentIntersectsSegment(c, d, rectD, rectA) ||
        segmentIntersectsSegment(d, a, rectA, rectB) ||
        segmentIntersectsSegment(d, a, rectB, rectC) ||
        segmentIntersectsSegment(d, a, rectC, rectD) ||
        segmentIntersectsSegment(d, a, rectD, rectA))
        return true;

    return false;
}

void main() {
    uint decalIndex = gl_GlobalInvocationID.x;

    if (decalIndex >= uint(DecalCount))
        return;

    visible[decalIndex] = VISIBLE;

    DecalData decal = decals[decalIndex];

    vec3 normal = normalize(decal.normal.xyz);

    vec3 tangent;
    vec3 bitangent;

    getDecalBasis(
            normal,
            decal.volumeAndRotation.w,
            tangent,
            bitangent
    );

    vec3 halfVolume = decal.volumeAndRotation.xyz * 0.5;

    vec3 corners[8];

    for (int x = -1; x <= 1; x += 2) {
        for (int y = -1; y <= 1; y += 2) {
            for (int z = -1; z <= 1; z += 2) {
                int index =
                (x > 0 ? 4 : 0) +
                (y > 0 ? 2 : 0) +
                (z > 0 ? 1 : 0);

                corners[index] =
                    decal.origin.xyz +
                    tangent * halfVolume.x * float(x) +
                    bitangent * halfVolume.y * float(y) +
                    normal * halfVolume.z * float(z);
            }
        }
    }

    vec3 surfaceCorners[4];

    float halfWidth = decal.volumeAndRotation.x * 0.5;
    float halfHeight = decal.volumeAndRotation.y * 0.5;

    surfaceCorners[0] = decal.origin.xyz - tangent * halfWidth - bitangent * halfHeight;
    surfaceCorners[1] = decal.origin.xyz - tangent * halfWidth + bitangent * halfHeight;
    surfaceCorners[2] = decal.origin.xyz + tangent * halfWidth + bitangent * halfHeight;
    surfaceCorners[3] = decal.origin.xyz + tangent * halfWidth - bitangent * halfHeight;

    vec2 quadScreen[4];

    vec2 minScreen = vec2(1.0);
    vec2 maxScreen = vec2(0.0);

    float minDepth = 1.0;

    for (int i = 0; i < 8; ++i) {
        vec4 clip = ViewProjection * vec4(corners[i] - CameraPosition, 1.0);

        if (clip.w <= 0.0)
            return;

        vec3 ndc = clip.xyz / clip.w;

        float depth = ndc.z * 0.5 + 0.5;

        minDepth = min(minDepth, depth);
    }

    for (int i = 0; i < 4; ++i) {
        vec4 clip = ViewProjection * vec4(surfaceCorners[i] - CameraPosition, 1.0);

        if (clip.w <= 0.0)
            return;

        vec3 ndc = clip.xyz / clip.w;

        quadScreen[i] = ndc.xy * 0.5 + 0.5;

        minScreen = min(minScreen, quadScreen[i]);
        maxScreen = max(maxScreen, quadScreen[i]);
    }

    if (maxScreen.x <= 0.0 || maxScreen.y <= 0.0 || minScreen.x >= 1.0 || minScreen.y >= 1.0)
        return;

    minScreen = clamp(minScreen, vec2(0.0), vec2(1.0));
    maxScreen = clamp(maxScreen, vec2(0.0), vec2(1.0));

    vec2 pixelMin = minScreen * ScreenSize;
    vec2 pixelMax = maxScreen * ScreenSize;

    vec2 extent = max(pixelMax - pixelMin, vec2(1.0));

    float largestExtent = max(extent.x, extent.y);

    int level = int(ceil(log2(largestExtent)));

    level = clamp(level, 0, int(PyramidLevels) - 1);

    int testLevel = level;

    while (testLevel >= 0) {
        ivec2 pyramidSize = textureSize(DepthPyramid, testLevel);

        vec2 scale = vec2(pyramidSize) / ScreenSize;

        ivec2 minTexel = ivec2(floor(pixelMin * scale)) - ivec2(1);
        ivec2 maxTexel = ivec2(ceil(pixelMax * scale)) + ivec2(1);

        minTexel = clamp(minTexel, ivec2(0), pyramidSize - 1);
        maxTexel = clamp(maxTexel, ivec2(0), pyramidSize - 1);

        float maxSceneDepth = 0.0;

        for (int y = minTexel.y; y <= maxTexel.y; ++y) {
            for (int x = minTexel.x; x <= maxTexel.x; ++x) {
                vec2 texelMin = vec2(x, y) / vec2(pyramidSize);
                vec2 texelMax = vec2(x + 1, y + 1) / vec2(pyramidSize);

                if (!quadIntersectsRect(
                        quadScreen[0],
                        quadScreen[1],
                        quadScreen[2],
                        quadScreen[3],
                        texelMin,
                        texelMax
                ))
                    continue;

                maxSceneDepth = max(maxSceneDepth, texelFetch(DepthPyramid, ivec2(x, y), testLevel).r);
            }
        }

        if (maxSceneDepth >= minDepth)
            return;
        --testLevel;
    }

    visible[decalIndex] = OCCLUDED;
}