#version 430

layout(local_size_x = 64) in;

struct DecalData {
    vec4 origin;
    vec4 normal;
    vec4 volumeAndRotation;
    vec4 textureBounds;
    vec4 textureInfo;
};

layout(std430, binding = 0) readonly buffer DecalBuffer {
    DecalData decals[];
};

layout(std430, binding = 1) writeonly buffer VisibilityBuffer {
    uint visible[];
};

layout(binding = 0) uniform sampler2D DepthPyramid;

uniform mat4 ViewProjection;
uniform int DecalCount;
uniform int PyramidLevels;
uniform vec2 ScreenSize;
uniform vec3 CameraPosition;

const uint VISIBLE = 1u;
const uint OCCLUDED = 0u;

const int MAX_POLY = 10;
const int MAX_STACK = 512;
const float DEPTH_EPSILON = 0.00025;

void getDecalBasis(
        vec3 normal,
        float rotation,
        out vec3 tangent,
        out vec3 bitangent
) {
    normal = normalize(normal);

    vec3 reference = abs(normal.y) < 0.999
        ? vec3(0.0, 1.0, 0.0)
        : vec3(1.0, 0.0, 0.0);

    tangent = normalize(cross(reference, normal));
    bitangent = normalize(cross(normal, tangent));

    float angle = radians(22.5) * rotation;

    float c = cos(angle);
    float s = sin(angle);

    vec3 rotatedTangent = tangent * c + bitangent * s;
    vec3 rotatedBitangent = -tangent * s + bitangent * c;

    tangent = rotatedTangent;
    bitangent = rotatedBitangent;
}

bool insidePlane(vec4 p, float d) {
    return p.z + p.w >= d;
}

int clipNearPlane(
        in vec4 src[MAX_POLY],
        int count,
        out vec4 dst[MAX_POLY]
) {
    if (count == 0)
        return 0;

    int outCount = 0;

    for (int i = 0; i < count; ++i) {
        vec4 a = src[i];
        vec4 b = src[(i + 1) % count];

        float da = a.z + a.w;
        float db = b.z + b.w;

        bool insideA = da >= 0.0;
        bool insideB = db >= 0.0;

        if (insideA && insideB)
            if (outCount < MAX_POLY)
                dst[outCount++] = b;
        else if (insideA && !insideB) {
            float t = da / (da - db);
            if (outCount < MAX_POLY)
                dst[outCount++] = mix(a, b, t);
        }
        else if (!insideA && insideB) {
            float t = da / (da - db);
            if (outCount < MAX_POLY)
                dst[outCount++] = mix(a, b, t);
            if (outCount < MAX_POLY)
                dst[outCount++] = b;
        }
    }

    return outCount;
}

float getAxis(vec3 p, int axis) {
    return axis == 0 ? p.x : p.y;
}

bool insideRect(vec3 p, int axis, float bound, bool greater) {
    float v = getAxis(p, axis);
    return greater ? v >= bound : v <= bound;
}

vec3 intersectRect(
        vec3 a,
        vec3 b,
        int axis,
        float bound
) {
    float av = getAxis(a, axis);
    float bv = getAxis(b, axis);
    float t = (bound - av) / (bv - av);
    return mix(a, b, t);
}

int clipRect(
        in vec3 src[MAX_POLY],
        int count,
        out vec3 dst[MAX_POLY],
        int axis,
        float bound,
        bool greater
) {
    if (count == 0)
        return 0;

    int outCount = 0;

    for (int i = 0; i < count; ++i) {
        vec3 a = src[i];
        vec3 b = src[(i + 1) % count];

        bool insideA = insideRect(a, axis, bound, greater);
        bool insideB = insideRect(b, axis, bound, greater);

        if (insideA && insideB)
            if (outCount < MAX_POLY)
                dst[outCount++] = b;
        else if (insideA && !insideB)
            if (outCount < MAX_POLY)
                dst[outCount++] = intersectRect(a, b, axis, bound);
        else if (!insideA && insideB) {
            if (outCount < MAX_POLY)
                dst[outCount++] = intersectRect(a, b, axis, bound);
            if (outCount < MAX_POLY)
                dst[outCount++] = b;
        }
    }

    return outCount;
}

int clipScreenRect(
        in vec3 src[MAX_POLY],
        int count,
        out vec3 dst[MAX_POLY],
        vec2 rectMin,
        vec2 rectMax
) {
    vec3 a[MAX_POLY];
    vec3 b[MAX_POLY];

    int n = count;

    for (int i = 0; i < count; ++i)
        a[i] = src[i];

    n = clipRect(a, n, b, 0, rectMin.x, true);
    n = clipRect(b, n, a, 0, rectMax.x, false);
    n = clipRect(a, n, b, 1, rectMin.y, true);
    n = clipRect(b, n, a, 1, rectMax.y, false);

    for (int i = 0; i < n; ++i)
        dst[i] = a[i];

    return n;
}

float polygonMinDepth(
        in vec3 poly[MAX_POLY],
        int count
) {
    float result = 1.0;

    for (int i = 0; i < count; ++i)
        result = min(result, poly[i].z);

    return result;
}

void main() {
    uint decalIndex = gl_GlobalInvocationID.x;

    if (decalIndex >= uint(DecalCount))
        return;

    visible[decalIndex] = VISIBLE;

    DecalData decal = decals[decalIndex];

    vec3 normal = normalize(decal.normal.xyz);

    vec3 tangent;
    vec3 bitangent;

    getDecalBasis(
            normal,
            decal.volumeAndRotation.w,
            tangent,
            bitangent
    );

    float halfWidth = decal.volumeAndRotation.x * 0.5;
    float halfHeight = decal.volumeAndRotation.y * 0.5;

    vec3 surfaceCorners[4];

    surfaceCorners[0] = decal.origin.xyz - tangent * halfWidth - bitangent * halfHeight;
    surfaceCorners[1] = decal.origin.xyz - tangent * halfWidth + bitangent * halfHeight;
    surfaceCorners[2] = decal.origin.xyz + tangent * halfWidth + bitangent * halfHeight;
    surfaceCorners[3] = decal.origin.xyz + tangent * halfWidth - bitangent * halfHeight;

    vec4 clipInput[MAX_POLY];
    vec4 clipOutput[MAX_POLY];

    for (int i = 0; i < 4; ++i)
        clipInput[i] = ViewProjection * vec4(surfaceCorners[i] - CameraPosition, 1.0);

    int clipCount = clipNearPlane(clipInput, 4, clipOutput);

    if (clipCount < 3) {
        visible[decalIndex] = OCCLUDED;
        return;
    }

    vec3 screenPoly[MAX_POLY];

    for (int i = 0; i < clipCount; ++i) {
        if (clipOutput[i].w <= 0.000001)
            return;

        vec3 ndc = clipOutput[i].xyz / clipOutput[i].w;

        screenPoly[i] = vec3(
                ndc.xy * 0.5 + 0.5,
                ndc.z * 0.5 + 0.5
        );
    }

    vec3 screenClipped[MAX_POLY];

    int screenCount = clipScreenRect(
            screenPoly,
            clipCount,
            screenClipped,
            vec2(0.0),
            vec2(1.0)
    );

    if (screenCount < 3) {
        visible[decalIndex] = OCCLUDED;
        return;
    }

    vec2 screenMin = vec2(1.0);
    vec2 screenMax = vec2(0.0);

    for (int i = 0; i < screenCount; ++i) {
        screenMin = min(screenMin, screenClipped[i].xy);
        screenMax = max(screenMax, screenClipped[i].xy);
    }

    vec2 pixelMin = screenMin * ScreenSize;
    vec2 pixelMax = screenMax * ScreenSize;

    vec2 extent = max(pixelMax - pixelMin, vec2(1.0));

    float largestExtent = max(extent.x, extent.y);

    float mipMetric = log2(largestExtent);
    int startLevel = int(floor(mipMetric - 0.25));

    startLevel = clamp(startLevel, 0, PyramidLevels - 1);

    while (startLevel > 0) {
        ivec2 testSize = textureSize(DepthPyramid, startLevel);

        vec2 testScale = vec2(testSize) / ScreenSize;

        vec2 testMin = pixelMin * testScale;
        vec2 testMax = pixelMax * testScale;

        vec2 footprint = testMax - testMin;

        if (footprint.x >= 1.0 && footprint.y >= 1.0)
            break;

        --startLevel;
    }

    ivec2 startSize = textureSize(
            DepthPyramid,
            startLevel
    );

    vec2 startScale = vec2(startSize) / ScreenSize;
    ivec2 firstTile = ivec2(floor(pixelMin * startScale));
    ivec2 lastTile = ivec2(ceil(pixelMax * startScale)) - ivec2(1);

    firstTile = clamp(firstTile, ivec2(0), startSize - 1);
    lastTile = clamp(lastTile, ivec2(0), startSize - 1);

    ivec3 stack[MAX_STACK];
    int stackSize = 0;

    for (int y = firstTile.y; y <= lastTile.y; ++y) {
        for (int x = firstTile.x; x <= lastTile.x; ++x) {
            if (stackSize >= MAX_STACK)
                break;

            stack[stackSize++] = ivec3(x, y, startLevel);
        }
    }

    while (stackSize > 0) {
        ivec3 node = stack[--stackSize];
        int level = node.z;
        ivec2 pyramidSize = textureSize(DepthPyramid, level);
        vec2 texelMin = vec2(node.xy) / vec2(pyramidSize);
        vec2 texelMax = vec2(node.xy + ivec2(1)) / vec2(pyramidSize);
        vec3 clippedPoly[MAX_POLY];

        int clippedCount = clipScreenRect(
                screenClipped,
                screenCount,
                clippedPoly,
                texelMin,
                texelMax
        );

        if (clippedCount < 3)
            continue;

        float nearestDecalDepth = polygonMinDepth(clippedPoly, clippedCount);
        float maxSceneDepth = texelFetch(DepthPyramid, node.xy, level).r;

        if (maxSceneDepth + DEPTH_EPSILON < nearestDecalDepth)
            continue;
        if (level == 0)
            return;

        int childLevel = level - 1;

        ivec2 childBase = node.xy * 2;

        ivec2 childSize = textureSize(DepthPyramid, childLevel);

        for (int oy = 0; oy < 2; ++oy) {
            for (int ox = 0; ox < 2; ++ox) {
                ivec2 child = childBase + ivec2(ox, oy);

                if (child.x < 0 ||
                    child.y < 0 ||
                    child.x >= childSize.x ||
                    child.y >= childSize.y)
                    continue;
                if (stackSize >= MAX_STACK)
                    return;

                stack[stackSize++] = ivec3(child, childLevel);
            }
        }
    }

    visible[decalIndex] = OCCLUDED;
}