#version 430

const uint LAYERS = 4u;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) buffer FragmentBuffer {
    uint fragments[];
};

layout(std430, binding = 1) readonly buffer LockBuffer {
    uint locks[];
};

uniform vec4 ScreenSize;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    uint width = uint(ScreenSize.x);
    uint height = uint(ScreenSize.y);

    if (x >= width || y >= height)
    return;

    uint pixelIndex = y * width + x;
    uint pixelCount = width * height;

    uint count = locks[pixelIndex];

    if (count <= 1u)
        return;

    if (count > LAYERS)
        count = LAYERS;

    uint depths[LAYERS];
    uint colors[LAYERS];
    uint lights[LAYERS];

    for (uint i = 0u; i < count; ++i) {
        uint offset = i * pixelCount * 3u + pixelIndex * 3u;

        depths[i] = fragments[offset];
        colors[i] = fragments[offset + 1u];
        lights[i] = fragments[offset + 2u];
    }

    for (uint i = 1u; i < count; ++i) {
        uint depth = depths[i];
        uint color = colors[i];
        uint light = lights[i];

        uint j = i;

        while (j > 0u && depths[j - 1u] > depth) {
            depths[j] = depths[j - 1u];
            colors[j] = colors[j - 1u];
            lights[j] = lights[j - 1u];
            --j;
        }

        depths[j] = depth;
        colors[j] = color;
        lights[j] = light;
    }

    for (uint i = 0u; i < count; ++i) {
        uint offset = i * pixelCount * 3u + pixelIndex * 3u;

        fragments[offset] = depths[i];
        fragments[offset + 1u] = colors[i];
        fragments[offset + 2u] = lights[i];
    }
}