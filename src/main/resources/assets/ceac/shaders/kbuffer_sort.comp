#version 430

const uint LAYERS = 4u;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) buffer FragmentBuffer {
    uint fragments[];
};

layout(std430, binding = 1) readonly buffer LockBuffer {
    uint locks[];
};

uniform vec4 ScreenSize;

void compareSwap(
        inout uint depthA,
        inout uint colorA,
        inout uint depthB,
        inout uint colorB
) {
    if (depthA > depthB) {
        uint tempDepth = depthA;
        uint tempColor = colorA;

        depthA = depthB;
        colorA = colorB;

        depthB = tempDepth;
        colorB = tempColor;
    }
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    uint width = uint(ScreenSize.x);
    uint height = uint(ScreenSize.y);

    if (x >= width || y >= height)
    return;

    uint pixelIndex = y * width + x;
    uint pixelCount = width * height;

    uint count = locks[pixelIndex];

    if (count <= 1u)
        return;

    if (count > LAYERS)
        count = LAYERS;

    uint depths[LAYERS];
    uint colors[LAYERS];

    for (uint i = 0u; i < count; ++i) {
        uint offset = i * pixelCount * 2u + pixelIndex * 2u;

        depths[i] = fragments[offset];
        colors[i] = fragments[offset + 1u];
    }

    for (uint pass = 0u; pass < count; ++pass) {
        uint start = pass & 1u;

        for (uint i = start; i + 1u < count; i += 2u) {
            compareSwap(
                    depths[i],
                    colors[i],
                    depths[i + 1u],
                    colors[i + 1u]
            );
        }
    }

    for (uint i = 0u; i < count; ++i) {
        uint offset = i * pixelCount * 2u + pixelIndex * 2u;

        fragments[offset] = depths[i];
        fragments[offset + 1u] = colors[i];
    }
}