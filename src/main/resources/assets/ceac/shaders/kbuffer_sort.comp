#version 430

const uint LAYERS = 4u;
const uint EMPTY = 0xFFFFFFFFu;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) buffer FragmentBuffer {
    uint fragments[];
};

uniform vec4 ScreenSize;

void compareSwap(
        inout uint depthA,
        inout uint colorA,
        inout uint depthB,
        inout uint colorB
) {
    if (depthA > depthB) {
        uint tempDepth = depthA;
        uint tempColor = colorA;

        depthA = depthB;
        colorA = colorB;

        depthB = tempDepth;
        colorB = tempColor;
    }
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    uint width = uint(ScreenSize.x);
    uint height = uint(ScreenSize.y);

    if (x >= width || y >= height)
        return;

    uint pixelIndex = y * width + x;
    uint base = pixelIndex * LAYERS * 2u;

    uint depths[LAYERS];
    uint colors[LAYERS];

    uint firstDepth = fragments[base];

    if (firstDepth == EMPTY)
        return;

    depths[0] = firstDepth;
    colors[0] = fragments[base + 1u];

    if (LAYERS == 1u)
        return;

    uint secondDepth = fragments[base + 2u];

    if (secondDepth == EMPTY)
        return;

    depths[1] = secondDepth;
    colors[1] = fragments[base + 3u];

    for (uint i = 2u; i < LAYERS; i++) {
        uint offset = base + i * 2u;

        depths[i] = fragments[offset];
        colors[i] = fragments[offset + 1u];
    }

    // Odd-even transposition sort
    for (uint pass = 0u; pass < LAYERS; pass++) {
        uint start = pass & 1u;

        for (uint i = start; i + 1u < LAYERS;i += 2u) {
            compareSwap(
                    depths[i],
                    colors[i],
                    depths[i + 1u],
                    colors[i + 1u]
            );
        }
    }

    for (uint i = 0u; i < LAYERS; i++) {
        uint offset = base + i * 2u;

        fragments[offset] = depths[i];
        fragments[offset + 1u] = colors[i];
    }
}